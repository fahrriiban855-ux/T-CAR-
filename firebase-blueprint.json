{
  "entities": {
    "User": {
      "title": "User",
      "description": "Fleet OS user profile with tenant, branch, and role boundaries",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 200 },
        "role": { "type": "string", "enum": ["admin", "operation", "finance", "driver"] },
        "tenantId": { "type": "string", "maxLength": 128 },
        "branchId": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "name", "role", "tenantId", "branchId"]
    },
    "Vehicle": {
      "title": "Vehicle",
      "description": "Commercial taxi vehicle asset, shift model, tariff, and compliance state",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "plate": { "type": "string", "maxLength": 20 },
        "brand": { "type": "string", "maxLength": 100 },
        "model": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["available", "in_custody", "in_shift", "maintenance", "blocked"] },
        "group": { "type": "string", "maxLength": 100 },
        "lastOdometer": { "type": "integer" },
        "tenantId": { "type": "string", "maxLength": 128 },
        "branchId": { "type": "string", "maxLength": 128 },
        "activeServiceCaseId": { "type": "string", "maxLength": 128 },
        "shiftModel": { "type": "string", "enum": ["2x12_double", "24h_single"] },
        "ownershipType": { "type": "string", "enum": ["owned", "leased_plate"] },
        "plateOwnerName": { "type": "string", "maxLength": 200 },
        "monthlyPlateRent": { "type": "integer" },
        "dailyDayRate": { "type": "integer" },
        "dailyNightRate": { "type": "integer" },
        "daily24hRate": { "type": "integer" },
        "assignedDayDriverId": { "type": "string", "maxLength": 128 },
        "assignedNightDriverId": { "type": "string", "maxLength": 128 },
        "nextMaintenanceOdometer": { "type": "integer" },
        "inspectionExpiry": { "type": "string", "maxLength": 64 },
        "insuranceExpiry": { "type": "string", "maxLength": 64 },
        "cascoExpiry": { "type": "string", "maxLength": 64 },
        "taximeterExpiry": { "type": "string", "maxLength": 64 },
        "stopName": { "type": "string", "maxLength": 120 }
      },
      "required": ["id", "plate", "brand", "model", "status", "group", "lastOdometer"]
    },
    "Driver": {
      "title": "Driver",
      "description": "Commercial taxi driver profile, IBB card compliance, deposit, and ledger state",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 200 },
        "status": { "type": "string", "enum": ["eligible", "conditional", "suspended"] },
        "tc": { "type": "string", "minLength": 11, "maxLength": 11 },
        "phone": { "type": "string", "maxLength": 30 },
        "tenantId": { "type": "string", "maxLength": 128 },
        "branchId": { "type": "string", "maxLength": 128 },
        "ibbCardNo": { "type": "string", "maxLength": 50 },
        "ibbCardExpiry": { "type": "string", "maxLength": 64 },
        "licenseExpiry": { "type": "string", "maxLength": 64 },
        "srcExpiry": { "type": "string", "maxLength": 64 },
        "psychotechnicExpiry": { "type": "string", "maxLength": 64 },
        "depositRequired": { "type": "integer" },
        "depositPaid": { "type": "integer" },
        "currentDebt": { "type": "integer" },
        "maxDebtLimit": { "type": "integer" },
        "unpaidFineCount": { "type": "integer" }
      },
      "required": ["id", "name", "status", "tc", "phone"]
    },
    "Custody": {
      "title": "Custody",
      "description": "Vehicle physical responsibility handover record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "vehicleId": { "type": "string", "maxLength": 128 },
        "driverId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["active", "returned", "disputed"] },
        "handedOverAt": { "type": "string", "maxLength": 64 },
        "returnedAt": { "type": "string", "maxLength": 64 },
        "odometerOut": { "type": "integer" },
        "odometerIn": { "type": "integer" },
        "tenantId": { "type": "string", "maxLength": 128 },
        "branchId": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "vehicleId", "driverId", "status", "handedOverAt", "odometerOut"]
    },
    "Shift": {
      "title": "Shift",
      "description": "Operational vehicle shift and cash/POS/IBAN collection record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "vehicleId": { "type": "string", "maxLength": 128 },
        "driverId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["active", "completed", "delayed"] },
        "startedAt": { "type": "string", "maxLength": 64 },
        "endedAt": { "type": "string", "maxLength": 64 },
        "type": { "type": "string", "maxLength": 50 },
        "slot": { "type": "string", "enum": ["day_12h", "night_12h", "full_24h"] },
        "accrual": { "type": "integer" },
        "collection": { "type": "integer" },
        "cashCollected": { "type": "integer" },
        "posCollected": { "type": "integer" },
        "ibanCollected": { "type": "integer" },
        "arrearsAmount": { "type": "integer" },
        "odometerStart": { "type": "integer" },
        "odometerEnd": { "type": "integer" },
        "tenantId": { "type": "string", "maxLength": 128 },
        "branchId": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "vehicleId", "driverId", "status", "startedAt", "type", "accrual", "collection"]
    },
    "ServiceCase": {
      "title": "ServiceCase",
      "description": "Vehicle maintenance and service dossier",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "vehicleId": { "type": "string", "maxLength": 128 },
        "tenantId": { "type": "string", "maxLength": 128 },
        "branchId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["open", "closed"] },
        "entryOdometer": { "type": "integer" },
        "reason": { "type": "string", "maxLength": 500 },
        "deliveredBy": { "type": "string", "maxLength": 200 },
        "provider": { "type": "string", "maxLength": 200 },
        "estimatedExitAt": { "type": "string", "maxLength": 64 },
        "costBearer": { "type": "string", "enum": ["company", "driver", "owner", "insurance"] },
        "createdAt": { "type": "string", "maxLength": 64 },
        "exitOdometer": { "type": "integer" },
        "invoiceDocumentNo": { "type": "string", "maxLength": 100 },
        "expenseAmount": { "type": "integer" },
        "ledgerEntryId": { "type": "string", "maxLength": 128 },
        "partsLinked": { "type": "boolean" },
        "resultSummary": { "type": "string", "maxLength": 500 },
        "vehicleEligible": { "type": "boolean" },
        "closedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "vehicleId", "tenantId", "branchId", "status", "entryOdometer", "reason", "deliveredBy", "provider", "estimatedExitAt", "costBearer", "createdAt"]
    },
    "PenaltyIncident": {
      "title": "PenaltyIncident",
      "description": "Traffic fine, HGS toll, and accident downtime (yatti parasi) driver attribution record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "tenantId": { "type": "string", "maxLength": 128 },
        "branchId": { "type": "string", "maxLength": 128 },
        "vehicleId": { "type": "string", "maxLength": 128 },
        "plate": { "type": "string", "maxLength": 20 },
        "driverId": { "type": "string", "maxLength": 128 },
        "driverName": { "type": "string", "maxLength": 200 },
        "type": { "type": "string", "enum": ["traffic_fine", "hgs_toll", "accident_damage", "downtime_loss"] },
        "violationAt": { "type": "string", "maxLength": 64 },
        "amount": { "type": "integer" },
        "downtimeDays": { "type": "integer" },
        "dailyYattiRate": { "type": "integer" },
        "faultPercentage": { "type": "integer" },
        "totalCharge": { "type": "integer" },
        "documentNo": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["pending_collection", "collected", "disputed"] },
        "description": { "type": "string", "maxLength": 500 },
        "matchedRecordId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "collectedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "tenantId", "branchId", "vehicleId", "plate", "driverId", "driverName", "type", "violationAt", "amount", "totalCharge", "documentNo", "status", "description", "createdAt"]
    },
    "PlateOwnerSettlement": {
      "title": "PlateOwnerSettlement",
      "description": "Leased commercial taxi plate owner monthly rent and expense deduction settlement",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "tenantId": { "type": "string", "maxLength": 128 },
        "branchId": { "type": "string", "maxLength": 128 },
        "ownerName": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 30 },
        "iban": { "type": "string", "maxLength": 64 },
        "plate": { "type": "string", "maxLength": 20 },
        "vehicleId": { "type": "string", "maxLength": 128 },
        "periodMonth": { "type": "string", "maxLength": 20 },
        "monthlyBaseRent": { "type": "integer" },
        "deductedExpenses": { "type": "integer" },
        "paidAmount": { "type": "integer" },
        "status": { "type": "string", "enum": ["open", "settled"] },
        "notes": { "type": "string", "maxLength": 500 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "tenantId", "branchId", "ownerName", "phone", "iban", "plate", "vehicleId", "periodMonth", "monthlyBaseRent", "deductedExpenses", "paidAmount", "status", "notes", "updatedAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable operational audit trail entry",
      "type": "object",
      "properties": {
        "auditId": { "type": "string", "maxLength": 128 },
        "tenantId": { "type": "string", "maxLength": 128 },
        "branchId": { "type": "string", "maxLength": 128 },
        "actorUserId": { "type": "string", "maxLength": 128 },
        "actorRole": { "type": "string", "maxLength": 50 },
        "action": { "type": "string", "maxLength": 100 },
        "entityType": { "type": "string", "maxLength": 100 },
        "entityId": { "type": "string", "maxLength": 128 },
        "reason": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "correlationId": { "type": "string", "maxLength": 128 }
      },
      "required": ["auditId", "tenantId", "branchId", "actorUserId", "actorRole", "action", "entityType", "entityId", "reason", "createdAt", "correlationId"]
    },
    "DayClose": {
      "title": "DayClose",
      "description": "Server-sealed daily close record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "tenantId": { "type": "string", "maxLength": 128 },
        "branchId": { "type": "string", "maxLength": 128 },
        "businessDate": { "type": "string", "maxLength": 20 },
        "status": { "type": "string", "enum": ["closed"] },
        "closedBy": { "type": "string", "maxLength": 128 },
        "closedAt": { "type": "string", "maxLength": 64 },
        "totalAccrual": { "type": "integer" },
        "totalCollection": { "type": "integer" },
        "cashDifference": { "type": "integer" },
        "previousCloseHash": { "type": "string", "maxLength": 128 },
        "signatureVersion": { "type": "string", "maxLength": 16 },
        "hash": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "tenantId", "branchId", "businessDate", "status", "closedBy", "closedAt", "totalAccrual", "totalCollection", "cashDifference", "previousCloseHash", "signatureVersion", "hash"]
    },
    "OtpRecord": {
      "title": "OtpRecord",
      "description": "Hashed one-time password record for custody verification",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "custodyId": { "type": "string", "maxLength": 128 },
        "tenantId": { "type": "string", "maxLength": 128 },
        "branchId": { "type": "string", "maxLength": 128 },
        "phone": { "type": "string", "maxLength": 30 },
        "codeHash": { "type": "string", "minLength": 64, "maxLength": 64 },
        "status": { "type": "string", "enum": ["requested", "sent", "verified", "expired", "consumed"] },
        "attempts": { "type": "integer" },
        "maxAttempts": { "type": "integer" },
        "expiresAt": { "type": "string", "maxLength": 64 },
        "resendAfter": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "custodyId", "tenantId", "branchId", "phone", "codeHash", "status", "attempts", "maxAttempts", "expiresAt", "resendAfter", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": { "schema": "User", "description": "User profiles" },
    "/vehicles/{vehicleId}": { "schema": "Vehicle", "description": "Fleet vehicles" },
    "/drivers/{driverId}": { "schema": "Driver", "description": "Fleet drivers" },
    "/custodies/{custodyId}": { "schema": "Custody", "description": "Custody handovers" },
    "/shifts/{shiftId}": { "schema": "Shift", "description": "Operational shifts" },
    "/service_cases/{caseId}": { "schema": "ServiceCase", "description": "Vehicle service cases" },
    "/penalties_incidents/{recordId}": { "schema": "PenaltyIncident", "description": "Traffic fines, HGS tolls, and accident downtime attributions" },
    "/plate_owners/{ownerId}": { "schema": "PlateOwnerSettlement", "description": "Plate owner monthly settlements" },
    "/audit_logs/{logId}": { "schema": "AuditLog", "description": "Immutable audit logs" },
    "/day_closes/{closeId}": { "schema": "DayClose", "description": "Server-sealed day closes" },
    "/otps/{otpId}": { "schema": "OtpRecord", "description": "Hashed OTP records" }
  }
}
